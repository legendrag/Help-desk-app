# Django Backend
DEBUG=1
SECRET_KEY=change-me-with-a-long-random-string
ALLOWED_HOSTS=*
# Required for working links inside notification emails (no trailing slash).
# Without this, emails contain relative paths like /tickets/1/ that mail apps cannot open.
# Examples:
# SITE_URL=http://localhost:8000
# SITE_URL=http://192.168.1.10:8000
# SITE_URL=https://helpdesk.example.com
SITE_URL=http://localhost:8000

# Database Engine: sqlite | mysql
DB_ENGINE=sqlite
DB_NAME=mlamehticket
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Initial super-admin (created on migrate only when password is set and not weak).
# Leave password empty to skip auto-create. Required and must be strong when DEBUG=0.
DEFAULT_SUPERADMIN_USERNAME=admin
DEFAULT_SUPERADMIN_EMAIL=admin@mlamehticket.local
DEFAULT_SUPERADMIN_PASSWORD=


# Backup settings (used by: python manage.py backup_db)
BACKUP_DIR=./backups
BACKUP_KEEP=7

# Web Push Settings (optional, generated dynamically if blank)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@mlamehticket.local
